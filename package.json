{
  "name": "caustic-icons",
  "version": "0.1.0",
  "description": "Solid glass icons that cast light.",
  "type": "module",
  "main": "./src/caustic.js",
  "types": "./src/caustic.d.ts",
  "exports": {
    ".": {
      "types": "./src/caustic.d.ts",
      "default": "./src/caustic.js"
    },
    "./react": {
      "types": "./src/react.d.ts",
      "default": "./src/react.js"
    },
    "./shader/*": "./shader/*",
    "./png/*": "./png/*"
  },
  "files": [
    "src",
    "shader",
    "png",
    "NOTICE"
  ],
  "sideEffects": [
    "./src/caustic.js",
    "./src/react.js"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "export": "node tools/export.mjs"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "playwright-core": "^1.50.0"
  },
  "keywords": [
    "icons",
    "webgl",
    "glass",
    "shader",
    "web-component",
    "caustics"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zqkra/caustic.git"
  },
  "author": "Zakra Gaviria",
  "license": "MIT"
}
